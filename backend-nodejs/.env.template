# Server Configuration
PORT=3001
NODE_ENV=production

# MongoDB Configuration
MONGODB_URI=your_mongodb_connection_string_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_this
JWT_EXPIRE=7d

# Email Configuration (Gmail SMTP) — used for OTP and password reset emails
# Step 1: Use a Gmail address dedicated to the app (e.g. noreply@healthmarketarena.com
#         or a Gmail like healthmarketarena.noreply@gmail.com)
# Step 2: Enable 2-Step Verification on that Google account
# Step 3: Generate an App Password:
#         Google Account → Security → 2-Step Verification → App Passwords
#         Select "Mail" + "Other (custom)" → copy the 16-character password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_app_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=Health Market Arena

# SMS/OTP Configuration
SMS_PROVIDER=twilio

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid
TWILIO_PHONE_NUMBER=your_twilio_phone

# CORS Configuration
FRONTEND_URL=https://healthmarketarena.com

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
